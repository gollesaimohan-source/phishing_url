MONGODB_URI=mongodb+srv://USERNAME:<PASSWORD>@cluster0.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
DATABASE_NAME=scamshield
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
DEBUG=True
# Set this to the deployed frontend origin(s) in production; local origins are useful for development.
CORS_ORIGINS=https://app.scamshield.example,http://localhost:3000,http://127.0.0.1:3000
# Optional: free key at https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
# GOOGLE_FACT_CHECK_API_KEY=your-google-fact-check-tools-api-key
# Optional: free credentials at https://sightengine.com. Image ML checks
# gracefully fall back to forensic heuristics when these are unset.
# SIGHTENGINE_API_USER=your-sightengine-api-user
# SIGHTENGINE_API_SECRET=your-sightengine-api-secret
MONGODB_STRICT=False
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_JWT_SECRET
JWT_EXPIRATION_MINUTES=60
BCRYPT_ROUNDS=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
